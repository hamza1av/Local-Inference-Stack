<!-- Laptop profile for Langfuse's ClickHouse: small caches, capped server memory,
     no system log tables (they are the main source of idle CPU, disk and memory). -->
<clickhouse>
    <logger>
        <level>warning</level>
        <console>1</console>
        <log remove="1"/>
        <errorlog remove="1"/>
    </logger>

    <!-- hard cap relative to the container limit (cgroup aware) -->
    <max_server_memory_usage_to_ram_ratio>0.8</max_server_memory_usage_to_ram_ratio>
    <mark_cache_size>67108864</mark_cache_size>                 <!-- 64 MiB (default 5 GiB) -->
    <index_mark_cache_size>16777216</index_mark_cache_size>
    <uncompressed_cache_size>16777216</uncompressed_cache_size>
    <primary_index_cache_size>33554432</primary_index_cache_size>
    <secondary_index_mark_cache_size>8388608</secondary_index_mark_cache_size>
    <mmap_cache_size>256</mmap_cache_size>
    <query_condition_cache_size>8388608</query_condition_cache_size>
    <compiled_expression_cache_size>8388608</compiled_expression_cache_size>
    <compiled_expression_cache_elements_size>1000</compiled_expression_cache_elements_size>
    <max_concurrent_queries>32</max_concurrent_queries>
    <max_thread_pool_size>500</max_thread_pool_size>
    <background_schedule_pool_size>16</background_schedule_pool_size>
    <background_message_broker_schedule_pool_size>1</background_message_broker_schedule_pool_size>
    <background_distributed_schedule_pool_size>1</background_distributed_schedule_pool_size>
    <background_buffer_flush_schedule_pool_size>1</background_buffer_flush_schedule_pool_size>

    <!-- system log tables: off -->
    <query_log remove="1"/>
    <query_thread_log remove="1"/>
    <query_views_log remove="1"/>
    <query_metric_log remove="1"/>
    <trace_log remove="1"/>
    <text_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <part_log remove="1"/>
    <processors_profile_log remove="1"/>
    <opentelemetry_span_log remove="1"/>
    <session_log remove="1"/>
    <zookeeper_log remove="1"/>
    <asynchronous_insert_log remove="1"/>
    <backup_log remove="1"/>
    <s3queue_log remove="1"/>
    <blob_storage_log remove="1"/>
    <error_log remove="1"/>
    <latency_log remove="1"/>
    <crash_log remove="1"/>
    <!-- 25.x: also writes a dead-letter / background-schedule log in some builds -->
    <dead_letter_queue remove="1"/>
    <background_schedule_pool_log remove="1"/>
</clickhouse>
