# Copied to .env by `just env` (secrets marked GENERATED are filled with random values).
# Every component reads this one file. See docs/ARCHITECTURE.md.

# --- paths -----------------------------------------------------------------
STACK_DATA=${HOME}/.local/share/inference-stack
STACK_DB=${STACK_DATA}/stack.db
# uzu checkout; the server binary is $UZU_DIR/target/release/cli
UZU_DIR=${HOME}/Projects/HOST_LLM/uzu

# --- models (run `$UZU_DIR/target/release/cli list-models` for ids) ----------
# 16 GB budget: chat 9B 4-bit (~6-7 GB) + task model (<1 GB). The decision model is
# another 9B: start it only on demand (`just decide-on`), ideally with a smaller chat model.
STACK_CHAT_MODEL=trymirai/Qwen3.5-9B-M
STACK_TASK_MODEL=trymirai/Qwen3.5-0.8B-M
STACK_DECIDE_MODEL=trymirai/d3-flash-M
UZU_CHAT_PORT=8000
UZU_TASK_PORT=8001
UZU_DECIDE_PORT=8002

# --- embeddings (Ollama, host, Metal) --------------------------------------
OLLAMA_URL=http://127.0.0.1:11434
STACK_EMBED_MODEL=embeddinggemma
STACK_EMBED_DIM=768

# --- gateway ---------------------------------------------------------------
# 0.0.0.0 lets Open WebUI (container) and the tailnet reach it; keys are required then.
GATEWAY_BIND=0.0.0.0:8088
GATEWAY_URL=http://127.0.0.1:8088/v1
# per-client API keys; clients send "Authorization: Bearer <key>"
OWUI_API_KEY=GENERATED
# key used by local components (agents, rag, kg, scripts) when talking to the gateway
STACK_API_KEY=GENERATED
# your own key for external clients (Claude Code, opencode, curl)
ME_API_KEY=GENERATED
# comma separated name:key pairs the gateway accepts; the name ends up in logs/traces
GATEWAY_KEYS=owui:${OWUI_API_KEY},stack:${STACK_API_KEY},me:${ME_API_KEY}

# --- component ports -------------------------------------------------------
KG_MCP_PORT=8090
RAG_MCP_PORT=8091
AGENTS_PORT=8092
FALKORDB_PORT=6390
FALKORDB_UI_PORT=3011

# --- knowledge graph -------------------------------------------------------
# Markdown folder to index. Keep it free of client / confidential material.
KG_VAULT=${STACK_DATA}/kg/vault
KG_GRAPH=kg
# extra git repos to index (colon separated), empty = none
KG_REPOS=

# --- tracing ---------------------------------------------------------------
STACK_OTLP_ENDPOINT=http://127.0.0.1:4320/api/public/otel
RECORDER_PORT=4320
LANGFUSE_PORT=3020
LANGFUSE_URL=http://127.0.0.1:3020
LANGFUSE_PUBLIC_KEY=pk-lf-stack
LANGFUSE_SECRET_KEY=GENERATED
LANGFUSE_ADMIN_EMAIL=admin@local.dev
LANGFUSE_ADMIN_PASSWORD=GENERATED
LANGFUSE_NEXTAUTH_SECRET=GENERATED
LANGFUSE_SALT=GENERATED
LANGFUSE_ENCRYPTION_KEY=GENERATED_HEX64
LANGFUSE_DB_PASSWORD=GENERATED
LANGFUSE_CLICKHOUSE_PASSWORD=GENERATED
LANGFUSE_REDIS_PASSWORD=GENERATED
LANGFUSE_MINIO_PASSWORD=GENERATED

# --- Open WebUI ------------------------------------------------------------
OWUI_PORT=3000
WEBUI_SECRET_KEY=GENERATED
SEARXNG_SECRET=GENERATED
